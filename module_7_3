import string

class WordsFinder:
    def __init__(self, *file_names):
        # Сохраняем имена файлов в атрибут file_names
        self.file_names = list(file_names)

    def get_all_words(self):
        # Создаем словарь для хранения слов из файлов
        all_words = {}
        for file_name in self.file_names:
            try:
                with open(file_name, 'r', encoding='utf-8') as file:
                    # Читаем содержимое файла
                    content = file.read().lower()
                    # Убираем пунктуацию
                    for char in [',', '.', '=', '!', '?', ';', ':', ' - ']:
                        content = content.replace(char, ' ')
                    # Разбиваем строку на слова
                    words = content.split()
                    # Добавляем слова в словарь
                    all_words[file_name] = words
            except FileNotFoundError:
                print(f"Файл {file_name} не найден.")
                all_words[file_name] = []
        return all_words

    def find(self, word):
        # Приводим искомое слово к нижнему регистру
        word = word.lower()
        # Получаем все слова из файлов
        all_words = self.get_all_words()
        result = {}
        for name, words in all_words.items():
            try:
                # Находим индекс первого вхождения слова
                position = words.index(word) + 1  # +1, чтобы отсчет был с 1
                result[name] = position
            except ValueError:
                # Если слово не найдено, пропускаем файл
                result[name] = None
        return result

    def count(self, word):
        word = word.lower()
        all_words = self.get_all_words()
        result = {}
        for name, words in all_words.items():
            count = words.count(word)
            result[name] = count
        return result


